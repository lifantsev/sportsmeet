# Copy this file to .env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql://localhost:5432/sportsmeet?sslmode=disable
PORT=3001

# Google sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Request-Forgery Protection
ALLOWED_ORIGINS="http://localhost:5173"

# Session secret for signing cookies. This should be a long, random string.
SESSION_SECRET=your_session_secret_here