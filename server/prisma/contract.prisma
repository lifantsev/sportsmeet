// use prisma-8
// the comment above is required by prisma ( genius design :O )

model User {
  id           Int              @id @default(autoincrement())
  email        String           @unique
  name         String?
  
  ownedGames   Game[]           @relation("GameOwner")
  joinedGames  GameParticipant[]

  createdAt    DateTime         @default(now())
}

model Game {
  id           Int              @id @default(autoincrement())
  sport        String
  place        String
  time         DateTime
  
  ownerId      Int
  owner        User             @relation("GameOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  participants GameParticipant[]

  createdAt    DateTime         @default(now())
}

model GameParticipant {
  userId       Int
  gameId       Int
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  joinedAt     DateTime         @default(now())

  @@id([userId, gameId]) // Composite primary key ensures a user can't join the same game twice
}
